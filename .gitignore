# Dependencies
node_modules/
.pnp
.pnp.js

# Production build output
dist/
dist-ssr/
build/
out-tsc/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Unwanted Replit template & workspace artifacts (anchored to root only)
/artifacts/
/lib/
/scripts/
/.replit
/.replitignore
/replit.md
/.conversation/
/.replit-artifact/
*.toml
/pnpm-workspace.yaml
/pnpm-lock.yaml
/tsconfig.base.json
/.npmrc

# Explicitly ensure src/lib is never ignored
!src/lib/
!src/lib/**

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Editor & IDE directories
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# OS metadata
.DS_Store
Thumbs.db
ehthumbs.db

# Replit & temporary system caches
.cache/
.local/
tmp/
temp/
coverage/
